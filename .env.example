# ─────────────────────────────────────────────────────────────
# Paradigm Cargo CRM — copy to .env on the server and fill in.
# NEVER commit the real .env. Secrets live only on the server.
# ─────────────────────────────────────────────────────────────
APP_NAME="Paradigm Cargo CRM"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://crm.paradigmcargo.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL / MariaDB from cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# On shared hosting there is no long-running worker:
# the cron (schedule:run every minute) also works the queue.
QUEUE_VIA_SCHEDULER=true

# Outgoing mail — Google Workspace (use an App Password, not the normal password)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=crm@paradigmcargo.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="crm@paradigmcargo.com"
MAIL_FROM_NAME="Paradigm Cargo"

# ── CRM ───────────────────────────────────────────────────────
CRM_SIGNUP_DOMAIN=paradigmcargo.com
CRM_STAGING_BANNER=false      # true on the staging copy only
DEMO_PASSWORD=                # staging demo users only (db:seed --class=DemoSeeder)

# Website contact form → API key is created in Settings → Lead form keys (not here)

# ── AI through OmniRoute (OpenAI-compatible) ─────────────────
# Switching model later (Gemini → Claude) = change AI_MODEL only.
AI_BASE_URL=                  # e.g. https://omniroute.example.com/v1
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_VISION_MODEL=              # empty = same as AI_MODEL
AI_TRANSCRIBE_MODEL=whisper-1
AI_TIMEOUT=60
# USD prices used for the monthly cost limit (Settings → AI)
AI_PRICE_IN_PER_M=0.30
AI_PRICE_OUT_PER_M=2.50
AI_PRICE_AUDIO_MIN=0.006

# Rates mailbox read by "vendor rate emails" (IMAP)
RATES_MAILBOX_ENABLED=false
RATES_IMAP_HOST=imap.gmail.com
RATES_IMAP_PORT=993
RATES_IMAP_ENCRYPTION=ssl
RATES_IMAP_USERNAME=rates@paradigmcargo.com
RATES_IMAP_PASSWORD=
RATES_IMAP_FOLDER=INBOX

# Browser push notifications: php artisan webpush:vapid
VAPID_SUBJECT=mailto:crm@paradigmcargo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── One-time migration from the old Supabase CRM (read-only) ──
# Remove these lines after the import is done.
LEGACY_DB_HOST=
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=postgres
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SSLMODE=require
LEGACY_STORAGE_URL=           # https://<project>.supabase.co
LEGACY_STORAGE_KEY=           # service key, read access to Storage

VITE_APP_NAME="${APP_NAME}"
